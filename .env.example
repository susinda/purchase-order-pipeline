SOURCE_API_URL=http://127.0.0.1:8000
KAFKA_BOOTSTRAP_SERVERS=kafka.example.invalid:18787
KAFKA_TOPIC=purchaseorders
KAFKA_SECURITY_PROTOCOL=SASL_SSL
KAFKA_SASL_MECHANISM=SCRAM-SHA-256
KAFKA_SASL_USERNAME=
KAFKA_SASL_PASSWORD=
KAFKA_SSL_CAFILE=/absolute/path/to/ca.pem
KAFKA_CONSUMER_CLIENT_ID=purchaseorders-inspector
KAFKA_CONSUMER_GROUP_ID=purchaseorders-consumer
KAFKA_AUTO_OFFSET_RESET=earliest
