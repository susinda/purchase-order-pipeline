# Astro deployment settings
# Entries marked *** are comments. Add those credentials as Secret variables in Astro.
# Store Snowflake authentication in the Airflow connection named below.

# APIs
SOURCE_API_URL=https://source-test.praxams.com
# SOURCE_API_USERNAME=***
# SOURCE_API_PASSWORD=***
TARGET_API_URL=https://target-test.praxams.com
# TARGET_API_USERNAME=***
# TARGET_API_PASSWORD=***

# Aiven Kafka
KAFKA_BOOTSTRAP_SERVERS=kafka-unisusi-unisusi-project.g.aivencloud.com:18787
KAFKA_SECURITY_PROTOCOL=SASL_SSL
KAFKA_SASL_MECHANISM=SCRAM-SHA-256
KAFKA_SSL_CAFILE=aiven_ca.pem
KAFKA_TOPIC=purchase-orders
KAFKA_BACKEND_GROUP_ID=purchase-orders-backend
KAFKA_ANALYTICS_GROUP_ID=purchase-orders-analytics
KAFKA_TARGET_DLT_TOPIC=purchase-orders.backend.dlt
KAFKA_SNOWFLAKE_DLT_TOPIC=purchase-orders.analytics.dlt
KAFKA_TEST_TOPIC=automatedtesttopic
KAFKA_TEST_GROUP_ID=purchaseorders-connection-test
# KAFKA_PRODUCER_SASL_USERNAME=***
# KAFKA_PRODUCER_SASL_PASSWORD=***
# KAFKA_CONSUMER_SASL_USERNAME=***
# KAFKA_CONSUMER_SASL_PASSWORD=***

# Snowflake
SNOWFLAKE_CONNECTION_ID=snowflake_default
SNOWFLAKE_RAW_TABLE=PURCHASE_ORDER_DB.RAW.PURCHASE_ORDER_EVENTS
SNOWFLAKE_DBT_PROJECT=PURCHASE_ORDER_DB.TRANSFORM.PO_DBT_PROJECT
