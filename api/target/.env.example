# Required Basic Auth credentials. Set them in the Coolify service environment
# or inject them as container environment variables from a Kubernetes Secret.
# Use ASCII credentials and a username without a colon.
TARGET_API_USERNAME=
TARGET_API_PASSWORD=

# Supply these as container environment variables in Coolify or Kubernetes.
# Use a MySQL host reachable from the container and an existing database.
# Store MYSQL_PASSWORD in a Coolify secret or Kubernetes Secret.
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_DATABASE=purchase_orders
MYSQL_USER=purchase_orders_app
MYSQL_PASSWORD=
